---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import OllamaPullDialog from "../components/OllamaPullDialog.astro";
import AccountDialog from "../components/AccountDialog.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  pageClass?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  pageClass = ""
} = Astro.props;
const basePath = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = Astro.site
  ? new URL(`${basePath}${canonicalPath.startsWith("/") ? canonicalPath : `/${canonicalPath}`}`, Astro.site)
  : Astro.url;
const favicon = `${basePath}/favicon.svg`;
const manifest = `${basePath}/site.webmanifest`;
const localApiOverride = import.meta.env.DEV ? import.meta.env.PUBLIC_OLLAMA_API : undefined;
---

<!doctype html>
<html lang="en" data-ollama-api={localApiOverride} data-base-path={basePath}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#10110f" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0c0a" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ailocal.click" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="manifest" href={manifest} />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <AccountDialog />
    <OllamaPullDialog />
    <div class="toast" data-toast role="status" aria-live="polite"></div>
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
