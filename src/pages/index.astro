---
import BaseLayout from "../layouts/BaseLayout.astro";
import Catalog from "../components/Catalog.astro";
import { catalog, models } from "../lib/catalog";

const basePath = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${basePath}${path}`;
---

<BaseLayout
  title="ailocal.click — every model in Ollama’s official library"
  description="Find, save, and download base models from Ollama's official library, with beginner help and a copy-command fallback."
  canonicalPath="/"
  pageClass="home-page"
>
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-kicker">Open models, clearly indexed</p>
      <h1><span>ailocal</span><em>.click</em></h1>
      <div class="hero-actions">
        <a class="button button-accent" href="#directory">Browse {models.length} models</a>
        <a class="button button-quiet-dark" href={href("/learn/")}>I'm new</a>
      </div>
      <div class="terminal-line" aria-label="Example Ollama command">
        <span class="terminal-prompt" aria-hidden="true">$</span>
        <code>ollama run <span>gemma3</span></code>
        <span class="terminal-status">local AI starts here</span>
      </div>
      <div class="hero-foot">
        <span>{models.length} base models</span>
      </div>
    </div>
  </section>

  <Catalog models={models} />

  <section class="novice-teaser" aria-labelledby="novice-title">
    <div class="novice-intro">
      <p class="eyebrow">Complete beginner?</p>
      <h2 id="novice-title">Ollama lets your computer run different AI brains.</h2>
      <p>Start with four ideas. No AI engineering knowledge required.</p>
      <a class="text-link" href={href("/learn/")}>Open the complete beginner guide <span aria-hidden="true">→</span></a>
    </div>
    <ol class="starter-flow">
      <li><span>01</span><strong>Install Ollama</strong><p>It is the engine that manages and runs models.</p></li>
      <li><span>02</span><strong>Choose a model</strong><p>Click a model and check its size on Ollama.</p></li>
      <li><span>03</span><strong>Confirm the download</strong><p>The page asks Ollama on your computer to pull it.</p></li>
      <li><span>04</span><strong>Start building</strong><p>Open Ollama or copy the run command when ready.</p></li>
    </ol>
  </section>

  <section class="trust-strip" aria-label="Site principles">
    <p><strong>Fast to browse.</strong> Search, filter, and compare the complete directory in one place.</p>
    <p><strong>Your click stays in control.</strong> A local download begins only after you confirm it.</p>
    <p><strong>Saved on this device.</strong> Keep a personal model list without creating an account.</p>
    <p><strong>Source-bounded.</strong> Catalog data comes from the <a href={catalog.source.url}>official Ollama library</a>.</p>
  </section>
</BaseLayout>
