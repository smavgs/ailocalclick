---
import HomeContent from "../../components/HomeContent.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  const localePages = {
    ru: {
      locale: "ru",
      title: "ailocal.click — выбирайте и создавайте с открытыми моделями",
      description: "Находите модели Ollama, сохраняйте личный список и копируйте одну команду, чтобы скачать и запустить модель на своём компьютере."
    },
    ko: {
      locale: "ko",
      title: "ailocal.click — 오픈 모델을 클릭하고 만들어 보세요",
      description: "Ollama 모델을 찾고 개인 목록에 저장한 뒤, 한 줄 명령어로 내 컴퓨터에 다운로드하고 실행하세요."
    },
    ja: {
      locale: "ja",
      title: "ailocal.click — オープンモデルをクリックして作ろう",
      description: "Ollamaモデルを探して個人リストに保存し、1つのコマンドをコピーして自分のコンピューターでダウンロード・実行できます。"
    },
    "zh-cn": {
      locale: "zh-CN",
      title: "ailocal.click — 点击并使用开放模型构建",
      description: "查找 Ollama 模型、保存私人列表，并复制一条命令，在你的电脑上下载并运行模型。"
    }
  } as const;
  return Object.entries(localePages).map(([locale, page]) => ({ params: { locale }, props: { page } }));
}

interface Props {
  page: {
    locale: "ru" | "ko" | "ja" | "zh-CN";
    title: string;
    description: string;
  };
}

const { page } = Astro.props;
const route = page.locale === "zh-CN" ? "zh-cn" : page.locale;
---

<BaseLayout
  title={page.title}
  description={page.description}
  canonicalPath={`/${route}/`}
  pageClass="home-page"
  locale={page.locale}
  localeRoute
  localizedHome
  englishTitle="ailocal.click — click & build with open models"
>
  <HomeContent />
</BaseLayout>
