---
import BaseLayout from "../layouts/BaseLayout.astro";

const basePath = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Page not found — ailocal.click" description="The requested ailocal.click page was not found." canonicalPath="/404/" pageClass="not-found-page">
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>That model path wandered off.</h1>
    <p>The official catalog may have changed, or the address may be incomplete.</p>
    <a class="button button-accent" href={`${basePath}/#directory`}>Return to all models</a>
  </section>
</BaseLayout>
