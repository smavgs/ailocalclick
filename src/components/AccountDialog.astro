---
const basePath = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${basePath}${path}`;
const googleEnabled = import.meta.env.PUBLIC_ENABLE_GOOGLE_AUTH === "true";
const appleEnabled = import.meta.env.PUBLIC_ENABLE_APPLE_AUTH === "true";
---

<dialog class="account-dialog" data-account-dialog aria-label="Account">
  <div class="account-dialog-inner">
    <button type="button" class="account-close" data-account-close aria-label="Close account panel">Close</button>

    <section class="account-loading" data-account-loading>
      <p class="eyebrow">Your account</p>
      <h2>Loading…</h2>
    </section>

    <section class="account-guest" data-account-guest hidden>
      <p class="eyebrow">Private model library</p>
      <h2>Sign in to save models.</h2>
      <p>Returning users sign in with a password. New users create an account once and confirm their email.</p>

      <div class="account-tabs" role="tablist" aria-label="Account action">
        <button type="button" role="tab" aria-selected="true" data-auth-mode="signin">Sign in</button>
        <button type="button" role="tab" aria-selected="false" data-auth-mode="signup">Create account</button>
      </div>

      <form class="account-email-form" data-account-email-form>
        <label for="account-email">Email address</label>
        <input id="account-email" name="email" type="email" inputmode="email" autocomplete="email" required placeholder="you@example.com" data-account-email />
        <label for="account-password">Password</label>
        <input id="account-password" name="password" type="password" minlength="8" maxlength="128" autocomplete="current-password" required placeholder="At least 8 characters" data-account-password />
        <div class="account-form-actions">
          <button type="submit" class="button button-accent" data-account-email-submit>Sign in</button>
          <button type="button" class="account-text-button" data-password-reset>Forgot password?</button>
        </div>
      </form>

      {(googleEnabled || appleEnabled) && <div class="account-divider"><span>or</span></div>}
      {(googleEnabled || appleEnabled) && (
        <div class="provider-buttons">
          {googleEnabled && <button type="button" class="button button-line" data-auth-provider="google">Continue with Google</button>}
          {appleEnabled && <button type="button" class="button button-line" data-auth-provider="apple">Continue with Apple</button>}
        </div>
      )}

      <p class="account-message" data-account-message role="status" aria-live="polite"></p>
      <p class="account-fine-print">Used the earlier email-link sign in? Choose <strong>Forgot password?</strong> once to set a password. Browsing and Copy &amp; run never require an account.</p>
    </section>

    <section class="account-recovery" data-account-recovery hidden>
      <p class="eyebrow">Password recovery</p>
      <h2>Choose a new password.</h2>
      <p>Your reset link is verified. Set a password to finish.</p>
      <form class="account-email-form" data-password-update-form>
        <input type="email" name="email" autocomplete="username" class="visually-hidden" tabindex="-1" aria-hidden="true" data-recovery-email />
        <label for="account-new-password">New password</label>
        <input id="account-new-password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required placeholder="At least 8 characters" data-account-new-password />
        <label for="account-confirm-password">Confirm password</label>
        <input id="account-confirm-password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required placeholder="Type it again" data-account-confirm-password />
        <button type="submit" class="button button-accent" data-password-update-submit>Save new password</button>
      </form>
      <p class="account-message" data-recovery-message role="status" aria-live="polite"></p>
    </section>

    <section class="account-member" data-account-member hidden>
      <p class="eyebrow">Signed in</p>
      <div class="account-identity">
        <span class="account-avatar account-avatar-large" data-account-avatar aria-hidden="true">A</span>
        <div>
          <h2 data-account-name>Your account</h2>
          <p data-account-email-display></p>
        </div>
      </div>
      <nav class="account-links" aria-label="Account shortcuts">
        <a class="button button-accent" href={href("/profile/")}>Open profile</a>
        <a class="button button-line" href={href("/saved/")}>My models</a>
      </nav>
      <button type="button" class="account-sign-out" data-account-sign-out>Sign out</button>
      <p class="account-message" data-account-member-message role="status" aria-live="polite"></p>
    </section>

    <section class="account-unavailable" data-account-unavailable hidden>
      <p class="eyebrow">Your account</p>
      <h2>Account setup is finishing.</h2>
      <p>Browsing and Copy &amp; run still work. Saving will be available when the private account service is connected.</p>
    </section>
  </div>
</dialog>
