---
const basePath = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${basePath}${path}`;
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <a class="footer-mark" href={href("/")}>ailocal.click</a>
      <p>Click &amp; build with ai open models, on your computer.</p>
    </div>
    <nav aria-label="Footer navigation">
      <a href={href("/profile/")}>Profile</a>
      <a href={href("/saved/")}>My models</a>
      <a href={href("/learn/")}>Beginner guide</a>
      <a href={href("/about/")}>About</a>
      <a href="mailto:corporate@agentmail.to">Contact</a>
      <a href="https://github.com/smavgs/ailocalclick" target="_blank" rel="noreferrer">Source code</a>
    </nav>
  </div>
</footer>
