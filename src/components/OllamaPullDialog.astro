---
const basePath = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${basePath}${path}`;
---

<dialog class="pull-dialog" data-pull-dialog aria-labelledby="pull-dialog-title">
  <div class="pull-dialog-inner">
    <button type="button" class="pull-close" data-pull-close aria-label="Close download panel">Close</button>

    <div class="pull-heading">
      <p class="eyebrow">Download with Ollama</p>
      <h2 id="pull-dialog-title" data-pull-title>Choose a model</h2>
      <p data-pull-intro>Confirm before Ollama downloads this model to your computer.</p>
      <p class="cloud-note" data-cloud-note hidden>This model is marked Cloud and may require an Ollama account or run remotely.</p>
    </div>

    <div class="pull-command" aria-label="Terminal fallback command">
      <code data-pull-command>ollama run</code>
      <button type="button" data-copy-command="">Copy command</button>
    </div>

    <div class="pull-actions">
      <button type="button" class="button button-accent" data-pull-start>Download with Ollama</button>
      <button type="button" class="button button-line" data-save-model="" aria-pressed="false" disabled>Save</button>
      <a class="button button-line" data-pull-official href="https://ollama.com/library" target="_blank" rel="noreferrer">Check size &amp; details ↗</a>
    </div>

    <section class="pull-progress" data-pull-progress-region hidden aria-live="polite" aria-atomic="true">
      <div class="pull-status-line">
        <strong data-pull-status>Connecting to Ollama…</strong>
        <span data-pull-percent></span>
      </div>
      <progress data-pull-progress max="100"></progress>
      <p data-pull-detail>Keep Ollama open while the model downloads. Hiding this panel may not stop a pull already accepted by Ollama.</p>
    </section>

    <div class="pull-error" data-pull-error hidden role="alert">
      <strong>Ollama could not accept the download.</strong>
      <p data-pull-error-message>Make sure Ollama is installed, open, and allowed to connect to this website.</p>
    </div>

    <div class="pull-success" data-pull-success hidden role="status">
      <strong>Model downloaded.</strong>
      <p>Open Ollama to use it, or copy the run command above.</p>
      <a class="text-link" href="ollama://">Open Ollama <span aria-hidden="true">→</span></a>
    </div>

    <div class="pull-footnote">
      <p>Model downloads can be large. Confirm the exact tag, size, license, and hardware needs on Ollama first.</p>
      <p>If the local connection is unavailable, the copy command works on macOS, Windows, and Linux.</p>
      <a href={href("/learn/#browser-download")}>Connection help for beginners <span aria-hidden="true">→</span></a>
    </div>
  </div>
</dialog>
