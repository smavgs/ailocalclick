---
import type { Model } from "../lib/catalog";
import { capabilityLabels, formatUpdatedDate } from "../lib/catalog";

interface Props {
  model: Model;
  savedOnly?: boolean;
}

const { model, savedOnly = false } = Astro.props;
const basePath = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/$/, "");
const detailHref = `${basePath}/model/${encodeURIComponent(model.slug)}/`;
const searchable = [model.name, model.description, ...model.capabilities, ...model.sizes].join(" ").toLowerCase();
const updatedNumber = model.updatedAt ? Date.parse(model.updatedAt) : 0;
const tagListId = `model-tags-${model.slug.replace(/[^a-z0-9_-]/gi, "-")}`;
---

<article
  class="model-row"
  data-model-row
  data-name={model.name.toLowerCase()}
  data-search={searchable}
  data-caps={model.capabilities.join(" ")}
  data-pulls={model.pullCount}
  data-updated={updatedNumber}
  data-model-slug={model.slug}
  data-model-name={model.name}
  data-model-command={model.runCommand}
  data-model-url={model.officialUrl}
  data-model-sizes={model.sizes.join(" ")}
  data-saved-only={savedOnly ? "true" : undefined}
  hidden={savedOnly}
>
  <a
    class="model-primary"
    href={detailHref}
    data-open-pull
    data-model-slug={model.slug}
    data-model-name={model.name}
    data-run-command={model.runCommand}
    data-official-url={model.officialUrl}
    data-model-cloud={model.capabilities.includes("cloud") ? "true" : "false"}
    aria-label={`Choose ${model.name} for download with Ollama`}
  >
    <div class="model-copy">
      <h3>{model.name}</h3>
      <p>{model.description}</p>
      <div class="badges" aria-label="Model attributes">
        {model.capabilities.map((capability) => (
          <span class:list={["badge", `badge-${capability}`]}>{capabilityLabels[capability] ?? capability}</span>
        ))}
        {model.sizes.slice(0, 8).map((size) => <span class="badge badge-size">{size}</span>)}
      </div>
    </div>
    <dl class="model-meta">
      <div><dt>Pulls</dt><dd>{model.pulls}</dd></div>
      <div><dt>Tags</dt><dd>{model.tagCount}</dd></div>
      <div>
        <dt>Updated</dt>
        <dd><time datetime={model.updatedAt ?? undefined}>{formatUpdatedDate(model.updatedAt, model.updatedLabel)}</time></dd>
      </div>
    </dl>
  </a>
  <div class="row-command">
    <code>{model.runCommand}</code>
    <div class="row-actions">
      <a class="row-detail" href={detailHref}>Details</a>
      <button
        type="button"
        class="save-button"
        data-save-model={model.slug}
        data-model-name={model.name}
        aria-pressed="false"
      >Save</button>
      <button type="button" class="copy-button" data-copy-command={model.runCommand} aria-label={`Copy ${model.runCommand}`}>
        Copy
      </button>
    </div>
  </div>
  {savedOnly && (
    <section class="saved-model-editor" data-saved-editor aria-label={`${model.name} saved model details`}>
      <div class="saved-detail-field saved-tag-field">
        <label for={`${tagListId}-input`}>Selected tag</label>
        <input
          id={`${tagListId}-input`}
          type="text"
          maxlength="120"
          value="latest"
          list={tagListId}
          autocomplete="off"
          spellcheck="false"
          placeholder="latest, 7b, q4_K_M…"
          data-saved-tag
        />
        <datalist id={tagListId}>
          <option value="latest"></option>
          {model.sizes.map((size) => <option value={size}></option>)}
        </datalist>
      </div>
      <div class="saved-detail-field saved-note-field">
        <label for={`${tagListId}-note`}>Personal note</label>
        <textarea
          id={`${tagListId}-note`}
          rows="2"
          maxlength="4000"
          placeholder="Why this model is useful to you…"
          data-saved-note
        ></textarea>
      </div>
      <div class="saved-editor-actions">
        <button type="button" class="button button-line" data-save-details>Update details</button>
        <p data-fit-guidance>Sign in and add your RAM or GPU for compatibility guidance.</p>
      </div>
    </section>
  )}
</article>
